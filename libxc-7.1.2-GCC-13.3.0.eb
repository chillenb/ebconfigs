easyblock = 'CMakeMake'

name = 'libxc'
version = '7.1.2'

homepage = 'https://libxc.gitlab.io'
description = """Libxc is a library of exchange-correlation functionals for density-functional theory.
 The aim is to provide a portable, well tested and reliable set of exchange and correlation functionals."""

toolchain = {'name': 'GCC', 'version': '13.3.0'}

source_urls = ['https://gitlab.com/%(name)s/%(name)s/-/archive/%(version)s/']
sources = [SOURCE_TAR_GZ]
checksums = ['c517ce61820ea8114664a4280b6a6bc74a4f22f1fd1ea4ddecd6df0caeeae4f4']

builddependencies = [
    ('CMake', '3.29.3'),
    ('Perl', '5.38.2'),
]

# shared library only; derivatives up to 3rd order (kxc), matching the Bouchet libxc used by
# localpyscf (libxc's default is 2, the upstream easyconfig builds 4th order and takes hours)
configopts = ' '.join([
    '-DBUILD_SHARED_LIBS=ON',
    '-DENABLE_FORTRAN=ON',
    '-DENABLE_XHOST=OFF',
    '-DMAXORDER=3',
    '-DBUILD_TESTING=OFF',
])

runtest = False

sanity_check_paths = {
    'files': ['bin/xc-info', 'include/xc.h', 'include/xc_funcs.h',
              'lib/libxc.%s' % SHLIB_EXT, 'lib/libxcf03.%s' % SHLIB_EXT],
    'dirs': ['lib/pkgconfig', 'lib/cmake/Libxc'],
}

sanity_check_commands = ['xc-info 1']

moduleclass = 'chem'
